{
  "name": "@bitrouter/pi",
  "version": "0.1.0",
  "description": "BitRouter provider extension for the pi coding agent",
  "type": "module",
  "license": "Apache-2.0",
  "author": "BitRouterAI",
  "homepage": "https://github.com/bitrouter/bitrouter-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitrouter/bitrouter-pi.git"
  },
  "bugs": {
    "url": "https://github.com/bitrouter/bitrouter-pi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-agent",
    "bitrouter",
    "llm",
    "ai-gateway",
    "provider"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./extensions/bitrouter": "./extensions/bitrouter.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema:refresh": "node scripts/refresh-schema.mjs",
    "schema:check": "node scripts/refresh-schema.mjs --check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
